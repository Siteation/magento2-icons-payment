<?xml version="1.0"?>
<!--
    Bind each payment icon view model to its icon set, which is a subdirectory of
    view/frontend/web/svg. The set goes to Hyvä's SvgIcons where that is installed,
    and into the <img> path otherwise.
-->
<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd"
>
    <type name="Siteation\IconsPayment\ViewModel\PaymentIcons">
        <arguments>
            <argument name="iconSet" xsi:type="string">default</argument>
        </arguments>
    </type>
    <type name="Siteation\IconsPayment\ViewModel\PaymentIconsFlat">
        <arguments>
            <argument name="iconSet" xsi:type="string">flat</argument>
        </arguments>
    </type>
    <type name="Siteation\IconsPayment\ViewModel\PaymentIconsMono">
        <arguments>
            <argument name="iconSet" xsi:type="string">mono</argument>
        </arguments>
    </type>
</config>
